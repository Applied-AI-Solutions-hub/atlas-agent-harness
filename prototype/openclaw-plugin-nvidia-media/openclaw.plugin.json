{
  "id": "atlas-nvidia-media",
  "activation": { "onStartup": true },
  "name": "Atlas NVIDIA Media",
  "description": "NVIDIA NIM media adapters for Atlas using the official NVIDIA Riva client.",
  "contracts": {
    "mediaUnderstandingProviders": ["nvidia"]
  },
  "mediaUnderstandingProviderMetadata": {
    "nvidia": {
      "capabilities": ["audio"],
      "defaultModels": { "audio": "nemotron-asr-streaming" },
      "autoPriority": { "audio": 10 }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pythonPath": { "type": "string" },
      "asrFunctionId": { "type": "string" }
    }
  }
}
