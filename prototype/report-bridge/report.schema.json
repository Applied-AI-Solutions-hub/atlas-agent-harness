{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appliedai.solutions/schemas/atlas-report.schema.json",
  "title": "Atlas shared report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "status", "privacyClass", "summary", "sections", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["Completed", "Partial", "Failed"] },
    "privacyClass": { "enum": ["public", "personal", "business-private"] },
    "summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentAction", "lastSuccess"],
      "properties": {
        "currentAction": { "type": ["string", "null"], "maxLength": 500 },
        "lastSuccess": { "type": ["string", "null"], "maxLength": 500 },
        "worker": { "type": ["string", "null"], "maxLength": 100 },
        "fallbackUsed": { "type": "boolean" }
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "blocks"],
        "properties": {
          "heading": { "type": "string", "minLength": 1, "maxLength": 200 },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "text"],
                  "properties": {
                    "type": { "const": "paragraph" },
                    "text": { "type": "string", "minLength": 1, "maxLength": 12000 },
                    "sourceIds": {
                      "type": "array",
                      "maxItems": 20,
                      "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "items"],
                  "properties": {
                    "type": { "const": "bullets" },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 50,
                      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
                    },
                    "sourceIds": {
                      "type": "array",
                      "maxItems": 20,
                      "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "url": { "type": "string", "format": "uri", "maxLength": 2000 },
          "publisher": { "type": "string", "maxLength": 200 },
          "accessedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
