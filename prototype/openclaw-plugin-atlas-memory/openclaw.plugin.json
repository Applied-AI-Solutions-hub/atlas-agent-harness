{
  "id": "atlas-memory",
  "name": "Atlas Memory",
  "description": "Bounded, source-linked retrieval from a shared canonical memory service.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string", "default": "http://127.0.0.1:8791" },
      "tokenFile": { "type": "string", "default": "/home/openclaw/.config/atlas-memory/tokens/atlas" },
      "namespaces": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["business/applied-ai-solutions", "agent/atlas", "public"]
      },
      "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000, "default": 1500 },
      "maxEvidenceTokens": { "type": "integer", "minimum": 128, "maximum": 2000, "default": 1200 }
    }
  }
}
