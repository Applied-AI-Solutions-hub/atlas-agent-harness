{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appliedai.solutions/schemas/capability-route-v1.json",
  "title": "Applied AI capability route",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "owner", "namespace", "privacyClass", "requestedCapability", "createdAt", "decision", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^route-[a-f0-9-]{36}$" },
    "owner": { "enum": ["sparky", "atlas"] },
    "namespace": { "type": "string", "minLength": 1, "maxLength": 80 },
    "privacyClass": { "enum": ["public", "personal", "personal-approved", "business-private", "business-approved"] },
    "requestedCapability": { "type": "string", "minLength": 1, "maxLength": 80 },
    "createdAt": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["executable", "needs-approval", "unavailable"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "steps": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "executor", "why", "maxWallSeconds"],
        "properties": {
          "id": { "type": "string", "pattern": "^step-[A-Za-z0-9._-]{1,80}$" },
          "dependsOn": { "type": "array", "uniqueItems": true, "maxItems": 12, "items": { "type": "string", "pattern": "^step-[A-Za-z0-9._-]{1,80}$" } },
          "capability": { "type": "string", "minLength": 1, "maxLength": 80 },
          "executor": { "type": "string", "minLength": 1, "maxLength": 80 },
          "why": { "type": "string", "minLength": 1, "maxLength": 500 },
          "expectedArtifact": { "type": "string", "maxLength": 160 },
          "maxWallSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
          "fallbackExecutor": { "type": "string", "maxLength": 80 }
        }
      }
    }
  }
}
