{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appliedai.solutions/schemas/agent-goal-v1.json",
  "title": "Applied AI bounded agent goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "rootRequestDigest", "owner", "createdBy", "namespace", "privacyClass", "objective", "successCriteria", "authority", "budgets", "loopPolicy", "status", "createdAt", "deadlineAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^goal-[a-f0-9-]{36}$" },
    "parentGoalId": { "type": "string", "pattern": "^goal-[a-f0-9-]{36}$" },
    "rootRequestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "owner": { "enum": ["sparky", "atlas"] },
    "createdBy": { "enum": ["user", "sparky", "atlas"] },
    "namespace": { "type": "string", "minLength": 1, "maxLength": 80 },
    "privacyClass": { "enum": ["public", "personal", "personal-approved", "business-private", "business-approved"] },
    "objective": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "successCriteria": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantedBy", "selfDirected", "allowedCapabilities", "allowedEffects"],
      "properties": {
        "grantedBy": { "enum": ["user", "parent-goal"] },
        "selfDirected": { "type": "boolean" },
        "allowedCapabilities": { "type": "array", "uniqueItems": true, "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "allowedEffects": { "type": "array", "uniqueItems": true, "maxItems": 8, "items": { "enum": ["read", "research", "draft", "index-proposal", "current-channel-progress", "approved-mutation"] } }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSteps", "maxChildren", "maxDepth", "maxWallSeconds", "maxSearches", "maxInputTokens", "maxOutputTokens"],
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 24 },
        "maxChildren": { "type": "integer", "minimum": 0, "maximum": 8 },
        "maxDepth": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maxWallSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "maxSearches": { "type": "integer", "minimum": 0, "maximum": 10 },
        "maxInputTokens": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 32000 }
      }
    },
    "loopPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxIdenticalActions", "maxNoProgressTicks", "maxReplans", "requireNewEvidence"],
      "properties": {
        "maxIdenticalActions": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxNoProgressTicks": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxReplans": { "type": "integer", "minimum": 0, "maximum": 2 },
        "requireNewEvidence": { "const": true }
      }
    },
    "status": { "enum": ["proposed", "active", "waiting", "succeeded", "blocked", "failed", "cancelled", "expired"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "deadlineAt": { "type": "string", "format": "date-time" },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentPhase": { "type": "string", "maxLength": 160 },
        "lastSuccess": { "type": "string", "maxLength": 500 },
        "lastEvidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "nextCapability": { "type": "string", "maxLength": 80 },
        "actionFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "stepCount": { "type": "integer", "minimum": 0, "maximum": 24 },
        "stallCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
