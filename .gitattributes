* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Linux and cross-platform sources must keep LF line endings.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.example text eol=lf

# Windows entry points use native CRLF line endings.
*.ps1 text eol=crlf
*.cmd text eol=crlf
